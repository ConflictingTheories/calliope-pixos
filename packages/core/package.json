{
  "name": "@pixospritz/core",
  "version": "1.0.0",
  "description": "PixoSpritz Core Engine - WebGL-based game engine",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./engine/*": "./src/engine/*",
    "./components/*": "./src/components/*",
    "./spritz/*": "./src/spritz/*"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "build": "cross-env NODE_ENV=production babel src --out-dir dist --copy-files --ignore __tests__,spec.js,test.js,stories.js,__snapshots__",
    "webpack": "webpack",
    "dev": "webpack --watch"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "pixospritz",
    "game-engine",
    "webgl",
    "canvas",
    "react"
  ],
  "homepage": "https://pixospritz.com",
  "repository": {
    "url": "https://github.com/ConflictingTheories/calliope-pixos.git",
    "type": "git"
  },
  "author": "Kyle Derby MacInnis",
  "license": "CC-BY-NC-SA-4.0",
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "dependencies": {
    "@pixospritz/math": "*",
    "@pixospritz/script": "*",
    "dexie": "^3.2.0",
    "file-saver": "^2.0.5",
    "gl-transition": "^1.13.0",
    "jszip": "^3.7.1",
    "printj": "^1.3.1",
    "prop-types": "^15.7.2",
    "realtime-bpm-analyzer": "^2.1.6",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.18.0",
    "@babel/preset-env": "^7.18.0",
    "@babel/preset-react": "^7.17.12",
    "babel-loader": "^8.2.5",
    "css-loader": "^6.7.1",
    "style-loader": "^3.3.1",
    "webpack": "^5.72.1",
    "webpack-cli": "^4.9.2",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.0"
  }
}
