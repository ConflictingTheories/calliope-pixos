{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pixospritz.dev/schemas/events.json",
  "title": "Event Type Constants",
  "description": "Shared event type identifiers for both engines",

  "categories": {
    "engine": "Core engine lifecycle events",
    "input": "User input events",
    "scene": "Scene/zone management events",
    "entity": "Entity lifecycle and interaction events",
    "audio": "Audio system events",
    "network": "Multiplayer/network events",
    "ui": "User interface events",
    "save": "State persistence events",
    "script": "Scripting system events"
  },

  "events": {
    "engine": {
      "ENGINE_INIT": { "description": "Engine initialization complete" },
      "ENGINE_START": { "description": "Game loop started" },
      "ENGINE_STOP": { "description": "Game loop stopped" },
      "ENGINE_PAUSE": { "description": "Game paused" },
      "ENGINE_RESUME": { "description": "Game resumed" },
      "ENGINE_TICK": { "description": "Frame update (per-frame)" },
      "ENGINE_RENDER": { "description": "Render pass complete" },
      "ENGINE_ERROR": { "description": "Engine error occurred" },
      "ENGINE_RESIZE": { "description": "Canvas resized" }
    },

    "input": {
      "KEY_DOWN": { "description": "Key pressed", "data": ["key", "code", "repeat"] },
      "KEY_UP": { "description": "Key released", "data": ["key", "code"] },
      "MOUSE_DOWN": { "description": "Mouse button pressed", "data": ["button", "x", "y"] },
      "MOUSE_UP": { "description": "Mouse button released", "data": ["button", "x", "y"] },
      "MOUSE_MOVE": { "description": "Mouse moved", "data": ["x", "y", "dx", "dy"] },
      "MOUSE_WHEEL": { "description": "Mouse wheel scrolled", "data": ["delta", "x", "y"] },
      "TOUCH_START": { "description": "Touch began", "data": ["touches"] },
      "TOUCH_MOVE": { "description": "Touch moved", "data": ["touches"] },
      "TOUCH_END": { "description": "Touch ended", "data": ["touches"] },
      "GAMEPAD_CONNECT": { "description": "Gamepad connected", "data": ["index", "id"] },
      "GAMEPAD_DISCONNECT": { "description": "Gamepad disconnected", "data": ["index"] },
      "GAMEPAD_BUTTON": {
        "description": "Gamepad button state changed",
        "data": ["index", "button", "pressed"]
      },
      "GAMEPAD_AXIS": { "description": "Gamepad axis moved", "data": ["index", "axis", "value"] }
    },

    "scene": {
      "ZONE_LOAD": { "description": "Zone loading started", "data": ["zoneId"] },
      "ZONE_READY": { "description": "Zone finished loading", "data": ["zoneId"] },
      "ZONE_ENTER": { "description": "Player entered zone", "data": ["zoneId", "fromZone"] },
      "ZONE_EXIT": { "description": "Player exiting zone", "data": ["zoneId", "toZone"] },
      "ZONE_CHANGE": {
        "description": "Zone transition complete",
        "data": ["zoneId", "previousZone"]
      },
      "WORLD_LOAD": { "description": "World loading started" },
      "WORLD_READY": { "description": "World finished loading" }
    },

    "entity": {
      "ENTITY_SPAWN": { "description": "Entity created", "data": ["entityId", "type"] },
      "ENTITY_DESTROY": { "description": "Entity removed", "data": ["entityId"] },
      "ENTITY_MOVE": { "description": "Entity position changed", "data": ["entityId", "position"] },
      "ENTITY_COLLIDE": { "description": "Entity collision", "data": ["entityA", "entityB"] },
      "ENTITY_INTERACT": { "description": "Player interacted with entity", "data": ["entityId"] },
      "SPRITE_ANIMATE": {
        "description": "Sprite animation changed",
        "data": ["spriteId", "animation"]
      },
      "AVATAR_SPAWN": { "description": "Avatar (player) spawned", "data": ["avatarId"] },
      "NPC_SPAWN": { "description": "NPC spawned", "data": ["npcId", "type"] },
      "TRIGGER_ENTER": {
        "description": "Entity entered trigger zone",
        "data": ["triggerId", "entityId"]
      },
      "TRIGGER_EXIT": {
        "description": "Entity exited trigger zone",
        "data": ["triggerId", "entityId"]
      }
    },

    "audio": {
      "AUDIO_PLAY": { "description": "Audio started playing", "data": ["trackId", "type"] },
      "AUDIO_STOP": { "description": "Audio stopped", "data": ["trackId"] },
      "AUDIO_PAUSE": { "description": "Audio paused", "data": ["trackId"] },
      "AUDIO_RESUME": { "description": "Audio resumed", "data": ["trackId"] },
      "AUDIO_END": { "description": "Audio playback ended", "data": ["trackId"] },
      "MUSIC_CHANGE": { "description": "Background music changed", "data": ["trackId"] },
      "BPM_DETECTED": { "description": "BPM analysis complete", "data": ["bpm"] }
    },

    "network": {
      "NET_CONNECT": { "description": "Connected to server" },
      "NET_DISCONNECT": { "description": "Disconnected from server" },
      "NET_RECONNECT": { "description": "Reconnected to server" },
      "NET_ERROR": { "description": "Network error", "data": ["error"] },
      "PLAYER_JOIN": { "description": "Remote player joined", "data": ["playerId"] },
      "PLAYER_LEAVE": { "description": "Remote player left", "data": ["playerId"] },
      "PLAYER_UPDATE": {
        "description": "Remote player state updated",
        "data": ["playerId", "state"]
      },
      "CHAT_MESSAGE": { "description": "Chat message received", "data": ["playerId", "message"] }
    },

    "ui": {
      "MENU_OPEN": { "description": "Menu opened", "data": ["menuId"] },
      "MENU_CLOSE": { "description": "Menu closed", "data": ["menuId"] },
      "MENU_SELECT": { "description": "Menu item selected", "data": ["menuId", "itemId"] },
      "DIALOG_OPEN": { "description": "Dialog box opened", "data": ["dialogId"] },
      "DIALOG_CLOSE": { "description": "Dialog box closed", "data": ["dialogId"] },
      "DIALOG_CHOICE": { "description": "Dialog choice made", "data": ["dialogId", "choiceIndex"] },
      "HUD_UPDATE": { "description": "HUD element updated", "data": ["elementId", "value"] },
      "CUTSCENE_START": { "description": "Cutscene started", "data": ["cutsceneId"] },
      "CUTSCENE_END": { "description": "Cutscene ended", "data": ["cutsceneId"] },
      "TRANSITION_START": { "description": "Screen transition started", "data": ["type"] },
      "TRANSITION_END": { "description": "Screen transition ended", "data": ["type"] }
    },

    "save": {
      "SAVE_START": { "description": "Save operation started", "data": ["slotId"] },
      "SAVE_COMPLETE": { "description": "Save operation complete", "data": ["slotId"] },
      "SAVE_ERROR": { "description": "Save operation failed", "data": ["slotId", "error"] },
      "LOAD_START": { "description": "Load operation started", "data": ["slotId"] },
      "LOAD_COMPLETE": { "description": "Load operation complete", "data": ["slotId"] },
      "LOAD_ERROR": { "description": "Load operation failed", "data": ["slotId", "error"] },
      "CHECKPOINT": { "description": "Checkpoint created", "data": ["label"] },
      "AUTOSAVE": { "description": "Autosave triggered" },
      "IMPORT_SAVE": { "description": "Save file imported", "data": ["sourceGameId"] }
    },

    "script": {
      "SCRIPT_LOAD": { "description": "Script loaded", "data": ["scriptId"] },
      "SCRIPT_ERROR": {
        "description": "Script runtime error",
        "data": ["scriptId", "error", "line"]
      },
      "CALLBACK_TRIGGER": { "description": "Callback executed", "data": ["callbackId"] },
      "ACTION_START": { "description": "Action started", "data": ["actionType", "entityId"] },
      "ACTION_END": { "description": "Action completed", "data": ["actionType", "entityId"] },
      "FLAG_CHANGE": { "description": "Game flag changed", "data": ["flagName", "value"] }
    }
  },

  "wildcards": {
    "description": "Pattern matching for event subscriptions",
    "examples": ["input:*", "entity:*", "*:error", "save:*"]
  }
}
