{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pixospritz.dev/schemas/manifest.schema.json",
  "title": "PixoSpritz Game Manifest",
  "description": "Schema for .pxz game package manifest files",
  "type": "object",
  "required": [
    "title",
    "version",
    "initialZones"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "pixozine",
      "description": "Package kind identifier. Currently only 'pixozine' is defined.",
      "default": "pixozine"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Pixozine package format version (semver). Absent in pre-1.0 packages; filled by the migration runner.",
      "default": "1.0.0"
    },
    "title": {
      "type": "string",
      "description": "Game title"
    },
    "description": {
      "type": "string",
      "description": "Game description"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Game version (semver)"
    },
    "author": {
      "type": "string",
      "description": "Game author/studio"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "consoleVersion": {
      "type": "string",
      "description": "Target console/runtime version"
    },
    "supportedConsoleVersions": {
      "type": "string",
      "description": "Semver range of supported console versions",
      "examples": [
        ">=1.0.0 <2.0.0"
      ]
    },
    "initialZones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Starting zone(s) for new game"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available game modes"
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Map/zone IDs included in package"
    },
    "tilesets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tileset IDs included in package"
    },
    "sprites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sprite IDs included in package"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "3D model IDs included in package"
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Texture paths included in package"
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Audio file paths included in package"
    },
    "shaders": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom shader IDs"
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Script file paths"
    },
    "cutscenes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cutscene definition paths"
    },
    "scriptApiVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Host scripting API version the package targets (default 1.0.0).",
      "default": "1.0.0"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Capability names the package's scripts require; the runtime grants only these."
    },
    "callbacks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Callback script paths"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Trigger script paths"
    },
    "playables": {
      "type": "array",
      "description": "Playable embeds: PixoSpritz game bundles playable inside this pixozine (added in format v1.1.0). Each entry is a playable block: metadata, pinned player version, bundle reference, and fallback content.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "playerVersion",
          "bundle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique playable ID within this package"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "poster": {
            "type": "string",
            "description": "Archive-relative poster image path shown before the player loads"
          },
          "playerVersion": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
            "description": "Pinned PixoSpritz player version (semver) this bundle is built for"
          },
          "bundle": {
            "type": "object",
            "required": [
              "uri",
              "manifestHash"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1,
                "description": "Archive-relative bundle path, or absolute https: URL for remote bundles"
              },
              "manifestHash": {
                "type": "string",
                "pattern": "^([0-9a-f]{8}|[0-9a-f]{64})$",
                "description": "Integrity hash of the bundle manifest: FNV-1a (8 lowercase hex chars) or SHA-256 (64 lowercase hex chars)"
              }
            },
            "additionalProperties": false
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "aspect": {
                "type": "string",
                "pattern": "^\\d+:\\d+$",
                "description": "Aspect ratio hint, e.g. \"16:9\"; used when width/height are absent"
              }
            },
            "additionalProperties": false
          },
          "fallback": {
            "type": "object",
            "description": "Content shown when the player cannot load (unsupported platform, blocked scripts)",
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "image": {
                "type": "string",
                "description": "Archive-relative fallback image path"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "thumbnail": {
      "type": "string",
      "description": "Path to game thumbnail image"
    },
    "trophies": {
      "type": "array",
      "description": "Achievement/trophy definitions for this game. Unlocked trophies sync to the player's SVRN identity when a sync provider is configured.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique trophy ID within this game"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "description": "Archive-relative icon image path"
          },
          "rarity": {
            "type": "string",
            "enum": [
              "common",
              "rare",
              "epic",
              "legendary"
            ],
            "description": "Trophy rarity tier"
          },
          "criteria": {
            "type": "object",
            "description": "Opaque criteria hint for tooling (not evaluated by the runtime)"
          }
        },
        "additionalProperties": false
      }
    },
    "icon": {
      "type": "string",
      "description": "Path to game icon"
    },
    "splash": {
      "type": "string",
      "description": "Path to splash screen image"
    },
    "settings": {
      "type": "object",
      "description": "Default game settings",
      "properties": {
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "fullscreen": {
          "type": "boolean"
        },
        "musicVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sfxVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "language": {
          "type": "string"
        }
      }
    },
    "saveConfig": {
      "type": "object",
      "description": "Save system configuration",
      "properties": {
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 3
        },
        "autosave": {
          "type": "boolean",
          "default": true
        },
        "autosaveInterval": {
          "type": "integer",
          "description": "Autosave interval in seconds",
          "default": 300
        },
        "quicksave": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "compatibleSaves": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Game IDs whose saves can be imported"
    },
    "portableItems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Item IDs that can be transferred between compatible games"
    },
    "multiplayer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": 2
        },
        "serverUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "controls": {
      "type": "object",
      "description": "Default control mappings",
      "properties": {
        "keyboard": {
          "type": "object"
        },
        "gamepad": {
          "type": "object"
        },
        "touch": {
          "type": "object"
        }
      }
    },
    "requirements": {
      "type": "object",
      "description": "System requirements",
      "properties": {
        "webgl": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "audio": {
          "type": "boolean"
        },
        "localStorage": {
          "type": "boolean"
        },
        "indexedDB": {
          "type": "boolean"
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Custom manifest data",
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "description": "Access control for this package: visibility, merging, forking, and live sessions.",
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "unlisted",
            "private"
          ],
          "default": "public",
          "description": "Who can discover and load this package."
        },
        "merge": {
          "type": "string",
          "enum": [
            "public",
            "allowlist",
            "private"
          ],
          "default": "public",
          "description": "Who can merge this world's content into another spritz."
        },
        "fork": {
          "type": "string",
          "enum": [
            "public",
            "allowlist",
            "private"
          ],
          "default": "public",
          "description": "Who can fork/branch this package into a derivative."
        },
        "liveSession": {
          "type": "string",
          "enum": [
            "public",
            "invite",
            "private"
          ],
          "default": "public",
          "description": "Who can join live sessions hosted in this package's zones."
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "SVRN identity IDs granted allowlist access."
        }
      },
      "additionalProperties": false
    }
  }
}
