{
  "name": "Particle Demo Zone",
  "description": "A comprehensive demo showcasing particles, dynamic scripting, and conditional events",
  "bounds": [0, 0, 16, 16],
  "tileset": "sewer",
  "audioSrc": "organ.mp3",
  "mode": "explore",
  "skybox": "cosmic",
