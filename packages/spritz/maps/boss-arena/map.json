  "scenes": [
    {
      "id": "final-battle-intro",
      "actions": [
        {
          "sprite": "dark-lord",
          "action": "dialogue",
          "args": [
            [
              "So... you've collected all four shards.",
              "Impressive, mortal. But futile.",
              "I am the Dark Lord, master of all elements!",
              "Your journey ends HERE!"
            ],
            false,
            { "autoclose": true }
          ]
        },
        { "trigger": "event/start_final_battle" }
      ]
    },
    {
      "id": "final-victory",
      "actions": [
        {
          "sprite": "dark-lord",
          "action": "dialogue",
          "args": [
            [
              "Impossible... defeated... by a mortal...",
              "The darkness... fades...",
              "You have saved... the kingdom..."
            ],
            false,
            { "autoclose": true }
          ]
        },
        { "trigger": "event/victory_celebration" }
      ]
    }
  ],

  "scripts": [
    {
      "id": "boss-arena-load",
