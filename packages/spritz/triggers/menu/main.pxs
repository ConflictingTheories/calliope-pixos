local _this = pixos.get_caller();
local world = pixos.get_world();
local menu = pixos.get_subject();

pixos.log(pixos.as_obj({ msg = 'opening main', menu = menu, scope = _this }));

pixos.to( menu, { 
  completed = true, 
});

pixos.to( world, { 
  isPaused = false, 
});

pixos.load_scripts(true);

-- After menu closes, trigger the cutscene demo
pixos.log('Menu closed - triggering cutscene showcase');

-- Load and run the menu close handler
local close_handler = require('triggers/menu/on_close');
if type(close_handler) == 'function' then
    close_handler(_this);
end
