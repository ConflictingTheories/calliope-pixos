-- Secret Area Approach
-- Trigger when player approaches the secret door area

local player = pixos.get_subject();
local state = pixos.get_state() or {};

pixos.log(pixos.as_obj({ msg = 'Approaching secret area', doorUnlocked = state.doorUnlocked, crystals = state.crystalsActivated }));

local door_pos = { 8, 2, 0 };

if state.doorUnlocked then
    -- Door is open - welcoming particles
    pixos.emit_particles(door_pos, {
        count = 25,
        life = 1500,
        speed = 0.03,
        spread = 1.5,
        size = 0.12,
        color = { 0.9, 0.85, 0.4 },
        gravity = { 0, 0, 0.001 },
        drag = 0.98
    });
    
    if not state.secretMessageShown then
        state.secretMessageShown = true;
        pixos.set_state(state);
        
        pixos.show_dialogue({
            speaker = 'Ancient Door',
            text = 'The way forward is open. Step through to face what lies beyond...'
        });
    end;
else
    -- Door is locked - warning particles
    local crystals = state.crystalsActivated or 0;
    
    pixos.emit_particles(door_pos, {
        count = 15,
        life = 1000,
        speed = 0.02,
        spread = 1.0,
        size = 0.1,
        color = { 0.5, 0.3, 0.3 },
        gravity = { 0, 0, 0.0005 },
        drag = 0.99
    });
    
    if crystals == 0 then
        pixos.show_dialogue({
            speaker = 'Ancient Door',
            text = 'A sealed door bars your path. Four crystals in the chamber must be activated...'
        });
    else
        pixos.show_dialogue({
            speaker = 'Ancient Door',
            text = 'The seal weakens... ' .. crystals .. ' of 4 crystals activated. Continue your work.'
        });
        
        -- Show progress with colored particles
        local progress_colors = {
            { 0.2, 0.6, 1.0 },
            { 1.0, 0.3, 0.3 },
            { 0.3, 1.0, 0.3 },
            { 1.0, 1.0, 0.2 }
        };
        for i = 1, crystals do
            pixos.delay(i * 200, function()
                pixos.emit_particles(door_pos, {
                    count = 8,
                    life = 1200,
                    speed = 0.025,
                    spread = 0.8,
                    size = 0.1,
                    color = progress_colors[i],
                    gravity = { 0, 0, 0.001 }
                });
            end);
        end;
    end;
end;
