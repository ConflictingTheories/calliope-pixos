-- Knight Guard NPC Interaction Script  
-- Provides combat tips and tracks quest progress

local npc = pixos.get_caller();
local player = pixos.get_subject();

pixos.log(pixos.as_obj({ 
    msg = 'Knight Guard Interaction', 
    npc = npc,
    player = player 
}));

-- Check game progress
local fire_complete = pixos.has_flag('fire_trial_complete');
local water_complete = pixos.has_flag('water_trial_complete');
local earth_complete = pixos.has_flag('earth_trial_complete');
local air_complete = pixos.has_flag('air_trial_complete');
local boss_defeated = pixos.has_flag('boss_defeated');

local trials_complete = 0;
if fire_complete then trials_complete = trials_complete + 1 end;
if water_complete then trials_complete = trials_complete + 1 end;
if earth_complete then trials_complete = trials_complete + 1 end;
if air_complete then trials_complete = trials_complete + 1 end;

-- Different dialogue based on progress
if boss_defeated then
    pixos.run_scene({
        {
            sprite = npc,
            action = 'dialogue',
            args = {
                {
                    "Hail, Champion of the Elements!",
                    "Your victory will be remembered for ages!",
                    "The four elemental guardians bow before you.",
                    "You have brought honor to all warriors!"
                },
                false,
                { autoclose = true }
            }
        }
    });
elseif trials_complete >= 4 then
    pixos.run_scene({
        {
            sprite = npc,
            action = 'dialogue',
            args = {
                {
                    "Incredible! All four shards obtained!",
                    "The boss chamber is now accessible!",
                    "Remember everything you've learned:",
                    "Passion, Adaptation, Endurance, Freedom!",
                    "May these virtues guide your blade!"
                },
                false,
                { autoclose = true }
            }
        }
    });
elseif trials_complete == 3 then
    pixos.run_scene({
        {
            sprite = npc,
            action = 'dialogue',
            args = {
                {
                    "Three shards! Only one trial remains!",
                    "You're almost ready to face the Dark Lord!",
                    "Complete the final trial and return victorious!"
                },
                false,
                { autoclose = true }
            }
        }
    });
elseif trials_complete == 2 then
    pixos.run_scene({
        {
            sprite = npc,
            action = 'dialogue',
            args = {
                {
                    "Two shards acquired! Excellent progress!",
                    "You're halfway to unlocking the boss chamber.",
                    "Two more trials await in the dungeon.",
                    "Stay focused, warrior!"
                },
                false,
                { autoclose = true }
            }
        }
    });
elseif trials_complete == 1 then
    pixos.run_scene({
        {
            sprite = npc,
            action = 'dialogue',
            args = {
                {
                    "Your first shard! A great start!",
                    "Three more trials await you.",
                    "Each element teaches a different lesson.",
                    "Remember: adapt your strategy to each foe!"
                },
                false,
                { autoclose = true }
            }
        }
    });
else
    -- Combat tutorial dialogue
    pixos.run_scene({
        {
            sprite = npc,
            action = 'dialogue',
            args = {
                {
                    "Greetings, aspiring hero!",
                    "The dungeon contains four elemental chambers.",
                    "FIRE tests your passion and willpower.",
                    "WATER tests your adaptability.",
                    "EARTH tests your endurance.",
                    "AIR tests your agility and freedom.",
                    "Enter the dungeon portal when ready!"
                },
                false,
                { autoclose = true }
            }
        }
    });
end;

return nil;
