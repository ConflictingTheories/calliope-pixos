-- Earth Battle Start Event
-- Triggered when the earth trial battle begins

pixos.log('Event: Earth Battle Started!');

-- Emit earth particles at boss location
pixos.emit_particles({6, 3, 1}, { preset = 'earth', count = 40, life = 2500 });

-- Set to tactics mode for turn-based combat
pixos.set_mode('tactics');

-- Play battle music with earth theme
pixos.play_bgm('audio/jungle-rhythm.mp3');

-- Log combat start
pixos.log('Earth Elemental battle in progress...');

return nil;
