-- Fire Battle Start Event
-- Triggered when the fire trial battle begins

pixos.log('Event: Fire Battle Started!');

-- Emit fire particles at boss location
pixos.emit_particles({6, 3, 1}, { preset = 'flame', count = 40, life = 2500 });

-- Set to tactics mode for turn-based combat
pixos.set_mode('tactics');

-- Play battle music
pixos.play_bgm('audio/brass-loop.mp3');

-- Log combat start
pixos.log('Fire Elemental battle in progress...');

return nil;
