-- Air Battle Start Event
-- Triggered when the air trial battle begins

pixos.log('Event: Air Battle Started!');

-- Emit air/wind particles at boss location
pixos.emit_particles({6, 3, 1}, { preset = 'air', count = 40, life = 2500 });

-- Set to tactics mode for turn-based combat
pixos.set_mode('tactics');

-- Play battle music with air theme
pixos.play_bgm('audio/icy-passage.mp3');

-- Log combat start
pixos.log('Air Elemental battle in progress...');

return nil;
