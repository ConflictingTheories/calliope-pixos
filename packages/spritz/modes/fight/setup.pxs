-- =============================================================================
-- FIGHT MODE - Real-Time Boss Battle Implementation
-- =============================================================================
-- Handles real-time action combat with health bars, attack patterns,
-- dodge mechanics, skill usage, and boss phase transitions.
-- =============================================================================

local FightMode = {}

-- =============================================================================
-- State Management
-- =============================================================================
FightMode.state = {
    -- Combat state
    isActive = false,
    isPaused = false,
    battleTime = 0,
    
    -- Player state
    player = {
        hp = 100,
        maxHp = 100,
        mp = 50,
        maxMp = 50,
        stamina = 100,
        maxStamina = 100,
        isAttacking = false,
        isDodging = false,
        isBlocking = false,
        isCasting = false,
        invincibleUntil = 0,
        comboCount = 0,
        comboTimer = 0,
        lastDamageTime = 0,
    },
    
    -- Boss state
    boss = {
        hp = 500,
        maxHp = 500,
        phase = 1,
        pattern = nil,
        patternTimer = 0,
        isAttacking = false,
        isVulnerable = false,
        vulnerableUntil = 0,
        attackCooldown = 0,
        enraged = false,
    },
    
    -- Combat tracking
    damageDealt = 0,
    damageTaken = 0,
    dodgesSuccessful = 0,
    skillsUsed = 0,
}

-- =============================================================================
-- Configuration
-- =============================================================================
FightMode.config = {
    -- Player settings
    playerMoveSpeed = 0.15,
    attackDamage = 15,
    attackCooldown = 400,      -- ms
    dodgeCooldown = 800,       -- ms
    dodgeDistance = 2,
    dodgeDuration = 300,       -- ms invincibility
    staminaCost = {
        dodge = 25,
        attack = 10,
        block = 5,  -- per frame while blocking
    },
    staminaRegen = 0.5,        -- per frame
    
    -- Boss settings
    bossPhases = {
        { hpThreshold = 0.75, pattern = 'normal' },
        { hpThreshold = 0.50, pattern = 'aggressive' },
        { hpThreshold = 0.25, pattern = 'desperate' },
        { hpThreshold = 0, pattern = 'final' },
    },
    
    -- UI settings
    healthBarWidth = 400,
    healthBarHeight = 20,
    staminaBarWidth = 200,
}

-- =============================================================================
-- Mode Registration
-- =============================================================================

pixos.register_mode('fight', {
    picker = false,

    -- =========================================================================
    -- SETUP - Initialize fight mode
    -- =========================================================================
    setup = function(params)
        pixos.log('fight: setup called', params)
        
        -- Reset state
        FightMode.resetState()
        
        -- Get player and boss references
        local world = pixos.get_world()
        FightMode.playerSprite = world.spriteDict and world.spriteDict['avatar']
        FightMode.bossSprite = world.spriteDict and world.spriteDict['boss']
        
        if not FightMode.playerSprite or not FightMode.bossSprite then
            pixos.log('fight: WARNING - missing player or boss sprite')
        end
        
        -- Initialize boss stats from sprite if available
        if FightMode.bossSprite and FightMode.bossSprite.stats then
            FightMode.state.boss.hp = FightMode.bossSprite.stats.hp or 500
            FightMode.state.boss.maxHp = FightMode.state.boss.hp
        end
        
        -- Initialize player stats
        if FightMode.playerSprite and FightMode.playerSprite.stats then
            FightMode.state.player.hp = FightMode.playerSprite.stats.hp or 100
            FightMode.state.player.maxHp = FightMode.state.player.hp
        end
        
        -- Play boss music
        pixos.play_music('deep-unknown-beat.mp3', { fadeIn = 1000 })
        
        -- Show fight HUD
        pixos.show_hud('fight')
        
        -- Start intro sequence
        FightMode.playIntro()
        
        FightMode.state.isActive = true
        
        return {}
    end,

    -- =========================================================================
    -- UPDATE - Per-frame update logic
    -- =========================================================================
    update = function(time, params)
        if not FightMode.state.isActive or FightMode.state.isPaused then
            return
        end
        
        local dt = 16.67  -- Assume ~60fps
        FightMode.state.battleTime = FightMode.state.battleTime + dt
        
        -- Check win/lose conditions
        if FightMode.checkBattleEnd() then
            return
        end
        
        -- Update player
        FightMode.updatePlayer(time, dt)
        
        -- Update boss
        FightMode.updateBoss(time, dt)
        
        -- Update combat interactions
        FightMode.checkCollisions()
        
        -- Update HUD
        FightMode.updateHUD()
        
        -- Regenerate stamina
        FightMode.regenStamina(dt)
    end,

    -- =========================================================================
    -- TEARDOWN - Cleanup
    -- =========================================================================
    teardown = function(params)
        pixos.log('fight: teardown')
        FightMode.state.isActive = false
        pixos.hide_hud('fight')
    end,

    -- =========================================================================
    -- INPUT HANDLER
    -- =========================================================================
    checkInput = function(time, params)
        if not FightMode.state.isActive then return false end
        
        local player = FightMode.state.player
        
        -- Pause
        if pixos.is_action_pressed('menu') then
            FightMode.togglePause()
            return true
        end
        
        if FightMode.state.isPaused then return true end
        
        -- Attack
        if pixos.is_action_pressed('attack') or pixos.is_action_pressed('select') then
            FightMode.playerAttack()
            return true
        end
        
        -- Dodge/Roll
        if pixos.is_action_pressed('dodge') or pixos.is_action_pressed('cancel') then
            FightMode.playerDodge()
            return true
        end
        
        -- Block (hold)
        if pixos.is_action_held('block') then
            FightMode.playerBlock(true)
        else
            FightMode.playerBlock(false)
        end
        
        -- Skills
        if pixos.is_action_pressed('skill1') then
            FightMode.useSkill(1)
            return true
        end
        if pixos.is_action_pressed('skill2') then
            FightMode.useSkill(2)
            return true
        end
        
        return false
    end,

    onSelect = function(zone, target, cell, type, params)
        return true  -- Block picking in fight mode
    end,
})

-- =============================================================================
-- State Management
-- =============================================================================

function FightMode.resetState()
    FightMode.state = {
        isActive = false,
        isPaused = false,
        battleTime = 0,
        player = {
            hp = 100,
            maxHp = 100,
            mp = 50,
            maxMp = 50,
            stamina = 100,
            maxStamina = 100,
            isAttacking = false,
            isDodging = false,
            isBlocking = false,
            isCasting = false,
            invincibleUntil = 0,
            comboCount = 0,
            comboTimer = 0,
            lastDamageTime = 0,
            attackCooldown = 0,
            dodgeCooldown = 0,
        },
        boss = {
            hp = 500,
            maxHp = 500,
            phase = 1,
            pattern = 'normal',
            patternTimer = 0,
            isAttacking = false,
            isVulnerable = false,
            vulnerableUntil = 0,
            attackCooldown = 0,
            enraged = false,
        },
        damageDealt = 0,
        damageTaken = 0,
        dodgesSuccessful = 0,
        skillsUsed = 0,
    }
end

-- =============================================================================
-- Player Actions
-- =============================================================================

function FightMode.updatePlayer(time, dt)
    local player = FightMode.state.player
    local sprite = FightMode.playerSprite
    if not sprite then return end
    
    -- Update cooldowns
    if player.attackCooldown > 0 then
        player.attackCooldown = player.attackCooldown - dt
    end
    if player.dodgeCooldown > 0 then
        player.dodgeCooldown = player.dodgeCooldown - dt
    end
    if player.comboTimer > 0 then
        player.comboTimer = player.comboTimer - dt
        if player.comboTimer <= 0 then
            player.comboCount = 0
        end
    end
    
    -- Handle movement if not in action
    if not player.isAttacking and not player.isDodging then
        FightMode.handlePlayerMovement(dt)
    end
    
    -- Update invincibility
    if player.invincibleUntil > 0 and time >= player.invincibleUntil then
        player.invincibleUntil = 0
        sprite:setAlpha(1.0)
    end
end

function FightMode.handlePlayerMovement(dt)
    local sprite = FightMode.playerSprite
    if not sprite then return end
    
    local dx, dy = 0, 0
    local speed = FightMode.config.playerMoveSpeed
    
    if pixos.is_action_held('move_up') then dy = -speed end
    if pixos.is_action_held('move_down') then dy = speed end
    if pixos.is_action_held('move_left') then dx = -speed end
    if pixos.is_action_held('move_right') then dx = speed end
    
    if dx ~= 0 or dy ~= 0 then
        -- Normalize diagonal
        if dx ~= 0 and dy ~= 0 then
            dx = dx * 0.7071
            dy = dy * 0.7071
        end
        
        local newX = sprite.pos.x + dx
        local newY = sprite.pos.y + dy
        
        -- Clamp to arena bounds
        local zone = pixos.get_current_zone()
        if zone then
            newX = math.max(zone.bounds[1] + 1, math.min(zone.bounds[3] - 1, newX))
            newY = math.max(zone.bounds[2] + 1, math.min(zone.bounds[4] - 1, newY))
        end
        
        sprite:moveTo(newX, newY)
        
        -- Face direction of movement
        if math.abs(dx) > math.abs(dy) then
            sprite:setFacing(dx > 0 and 'Right' or 'Left')
        else
            sprite:setFacing(dy > 0 and 'Down' or 'Up')
        end
        
        sprite:setAnimation('walk')
    else
        sprite:setAnimation('idle')
    end
end

function FightMode.playerAttack()
    local player = FightMode.state.player
    if player.attackCooldown > 0 or player.stamina < FightMode.config.staminaCost.attack then
        return
    end
    
    player.isAttacking = true
    player.attackCooldown = FightMode.config.attackCooldown
    player.stamina = player.stamina - FightMode.config.staminaCost.attack
    
    -- Increment combo
    player.comboCount = player.comboCount + 1
    player.comboTimer = 1500  -- 1.5s combo window
    
    -- Play attack animation
    FightMode.playerSprite:playAnimation('attack', function()
        player.isAttacking = false
    end)
    
    -- Check if hitting boss
    local dist = FightMode.distance(FightMode.playerSprite.pos, FightMode.bossSprite.pos)
    if dist < 2 then
        local damage = FightMode.config.attackDamage
        
        -- Combo multiplier
        damage = damage * (1 + player.comboCount * 0.1)
        
        -- Critical during vulnerable phase
        if FightMode.state.boss.isVulnerable then
            damage = damage * 2
            pixos.show_notification('Critical Hit!')
        end
        
        FightMode.damageBoss(math.floor(damage))
    end
    
    pixos.play_sound('sword_swing.mp3')
    pixos.emit_particles(FightMode.playerSprite.pos, { preset = 'weapon' })
end

function FightMode.playerDodge()
    local player = FightMode.state.player
    if player.dodgeCooldown > 0 or player.stamina < FightMode.config.staminaCost.dodge then
        return
    end
    
    player.isDodging = true
    player.dodgeCooldown = FightMode.config.dodgeCooldown
    player.stamina = player.stamina - FightMode.config.staminaCost.dodge
    player.invincibleUntil = FightMode.state.battleTime + FightMode.config.dodgeDuration
    
    -- Determine dodge direction
    local dx, dy = 0, 0
    if pixos.is_action_held('move_up') then dy = -1 end
    if pixos.is_action_held('move_down') then dy = 1 end
    if pixos.is_action_held('move_left') then dx = -1 end
    if pixos.is_action_held('move_right') then dx = 1 end
    
    -- Default: dodge away from boss
    if dx == 0 and dy == 0 and FightMode.bossSprite then
        dx = FightMode.playerSprite.pos.x - FightMode.bossSprite.pos.x
        dy = FightMode.playerSprite.pos.y - FightMode.bossSprite.pos.y
        local len = math.sqrt(dx*dx + dy*dy)
        if len > 0 then dx, dy = dx/len, dy/len end
    end
    
    local targetX = FightMode.playerSprite.pos.x + dx * FightMode.config.dodgeDistance
    local targetY = FightMode.playerSprite.pos.y + dy * FightMode.config.dodgeDistance
    
    -- Flash effect during dodge
    FightMode.playerSprite:setAlpha(0.5)
    
    FightMode.playerSprite:moveTo(targetX, targetY, {
        speed = 50,
        onComplete = function()
            player.isDodging = false
        end
    })
    
    FightMode.state.dodgesSuccessful = FightMode.state.dodgesSuccessful + 1
    pixos.play_sound('dodge.mp3')
end

function FightMode.playerBlock(isBlocking)
    local player = FightMode.state.player
    
    if isBlocking and player.stamina > 0 then
        player.isBlocking = true
        player.stamina = math.max(0, player.stamina - FightMode.config.staminaCost.block)
        FightMode.playerSprite:playAnimation('block')
    else
        player.isBlocking = false
    end
end

function FightMode.useSkill(skillNum)
    local player = FightMode.state.player
    
    if player.mp < 20 then
        pixos.show_notification('Not enough MP!')
        return
    end
    
    player.mp = player.mp - 20
    FightMode.state.skillsUsed = FightMode.state.skillsUsed + 1
    
    if skillNum == 1 then
        -- Healing skill
        player.hp = math.min(player.maxHp, player.hp + 30)
        pixos.emit_particles(FightMode.playerSprite.pos, { preset = 'water', count = 20 })
        pixos.show_notification('Healed 30 HP!')
    elseif skillNum == 2 then
        -- Powerful attack
        if FightMode.bossSprite then
            FightMode.damageBoss(50)
            pixos.emit_particles(FightMode.bossSprite.pos, { preset = 'flame', count = 30 })
        end
    end
    
    pixos.play_sound('skill.mp3')
end

-- =============================================================================
-- Boss AI
-- =============================================================================

function FightMode.updateBoss(time, dt)
    local boss = FightMode.state.boss
    local sprite = FightMode.bossSprite
    if not sprite then return end
    
    -- Update cooldowns
    if boss.attackCooldown > 0 then
        boss.attackCooldown = boss.attackCooldown - dt
    end
    boss.patternTimer = boss.patternTimer + dt
    
    -- Update vulnerability window
    if boss.vulnerableUntil > 0 and time >= boss.vulnerableUntil then
        boss.isVulnerable = false
        boss.vulnerableUntil = 0
        sprite:setHighlight(false)
    end
    
    -- Check phase transitions
    FightMode.checkBossPhase()
    
    -- Execute pattern
    FightMode.executeBossPattern(time, dt)
end

function FightMode.checkBossPhase()
    local boss = FightMode.state.boss
    local hpPercent = boss.hp / boss.maxHp
    
    for i, phase in ipairs(FightMode.config.bossPhases) do
        if hpPercent <= phase.hpThreshold and boss.phase < i then
            boss.phase = i
            boss.pattern = phase.pattern
            boss.patternTimer = 0
            
            -- Phase transition effect
            pixos.show_notification('Boss enters ' .. phase.pattern .. ' phase!')
            pixos.emit_particles(FightMode.bossSprite.pos, { preset = 'flame', count = 50, life = 2000 })
            pixos.screen_shake(10, 500)
            
            if i >= 3 then
                boss.enraged = true
                FightMode.bossSprite:setTint(1.5, 0.5, 0.5)
            end
            
            break
        end
    end
end

function FightMode.executeBossPattern(time, dt)
    local boss = FightMode.state.boss
    local sprite = FightMode.bossSprite
    if not sprite or boss.isAttacking then return end
    
    local pattern = boss.pattern
    local interval = pattern == 'desperate' and 1000 or (pattern == 'aggressive' and 1500 or 2000)
    
    if boss.attackCooldown <= 0 then
        -- Choose attack based on pattern
        local attacks = {'slam', 'charge', 'sweep'}
        if pattern == 'aggressive' or pattern == 'desperate' then
            table.insert(attacks, 'shockwave')
        end
        if pattern == 'final' then
            table.insert(attacks, 'ultimate')
        end
        
        local attack = attacks[math.random(#attacks)]
        FightMode.executeBossAttack(attack)
        boss.attackCooldown = interval
    end
    
    -- Track player between attacks
    if not boss.isAttacking then
        FightMode.bossTrackPlayer(dt)
    end
end

function FightMode.bossTrackPlayer(dt)
    local sprite = FightMode.bossSprite
    local player = FightMode.playerSprite
    if not sprite or not player then return end
    
    local dx = player.pos.x - sprite.pos.x
    local dy = player.pos.y - sprite.pos.y
    local dist = math.sqrt(dx*dx + dy*dy)
    
    if dist > 2 then
        -- Move towards player slowly
        dx, dy = dx/dist * 0.03, dy/dist * 0.03
        sprite:moveTo(sprite.pos.x + dx, sprite.pos.y + dy)
    end
    
    -- Face player
    if math.abs(dx) > math.abs(dy) then
        sprite:setFacing(dx > 0 and 'Right' or 'Left')
    else
        sprite:setFacing(dy > 0 and 'Down' or 'Up')
    end
end

function FightMode.executeBossAttack(attackType)
    local boss = FightMode.state.boss
    local sprite = FightMode.bossSprite
    
    boss.isAttacking = true
    
    if attackType == 'slam' then
        -- Ground slam - damages nearby
        sprite:playAnimation('attack', function()
            FightMode.checkBossHit(3, 30)
            pixos.screen_shake(8, 300)
            pixos.emit_particles(sprite.pos, { preset = 'sparks', count = 20 })
            boss.isAttacking = false
            boss.isVulnerable = true
            boss.vulnerableUntil = FightMode.state.battleTime + 1000
            sprite:setHighlight(true)
        end)
        
    elseif attackType == 'charge' then
        -- Charge at player
        local player = FightMode.playerSprite
        if player then
            sprite:moveTo(player.pos.x, player.pos.y, {
                speed = 30,
                onComplete = function()
                    FightMode.checkBossHit(1.5, 25)
                    boss.isAttacking = false
                end
            })
        end
        
    elseif attackType == 'sweep' then
        -- Wide sweep attack
        sprite:playAnimation('attack', function()
            FightMode.checkBossHit(4, 20)
            boss.isAttacking = false
        end)
        
    elseif attackType == 'shockwave' then
        -- Ring of damage
        pixos.emit_particles(sprite.pos, { preset = 'flame', count = 40, spread = 2 })
        FightMode.checkBossHit(5, 35)
        pixos.screen_shake(5, 200)
        boss.isAttacking = false
        
    elseif attackType == 'ultimate' then
        -- Multi-hit attack
        for i = 1, 3 do
            pixos.delay(i * 300, function()
                FightMode.checkBossHit(6, 15)
                pixos.emit_particles(sprite.pos, { preset = 'flame', count = 30 })
            end)
        end
        pixos.delay(1000, function()
            boss.isAttacking = false
            boss.isVulnerable = true
            boss.vulnerableUntil = FightMode.state.battleTime + 2000
            sprite:setHighlight(true)
        end)
    end
    
    pixos.play_sound('boss_attack.mp3')
end

-- =============================================================================
-- Combat Resolution
-- =============================================================================

function FightMode.checkBossHit(range, damage)
    local player = FightMode.state.player
    local dist = FightMode.distance(FightMode.playerSprite.pos, FightMode.bossSprite.pos)
    
    if dist <= range then
        FightMode.damagePlayer(damage)
    end
end

function FightMode.damagePlayer(amount)
    local player = FightMode.state.player
    
    -- Check invincibility
    if player.invincibleUntil > FightMode.state.battleTime then
        FightMode.state.dodgesSuccessful = FightMode.state.dodgesSuccessful + 1
        return
    end
    
    -- Reduce damage if blocking
    if player.isBlocking then
        amount = math.floor(amount * 0.3)
        player.stamina = math.max(0, player.stamina - amount)
        pixos.show_notification('Blocked!')
    end
    
    player.hp = math.max(0, player.hp - amount)
    player.lastDamageTime = FightMode.state.battleTime
    player.comboCount = 0  -- Break combo on hit
    
    FightMode.state.damageTaken = FightMode.state.damageTaken + amount
    
    -- Flash player red
    FightMode.playerSprite:flash(255, 0, 0, 200)
    pixos.show_damage_number(FightMode.playerSprite.pos, amount, 'red')
    pixos.screen_shake(3, 100)
    pixos.play_sound('player_hurt.mp3')
end

function FightMode.damageBoss(amount)
    local boss = FightMode.state.boss
    
    boss.hp = math.max(0, boss.hp - amount)
    FightMode.state.damageDealt = FightMode.state.damageDealt + amount
    
    FightMode.bossSprite:flash(255, 255, 255, 100)
    pixos.show_damage_number(FightMode.bossSprite.pos, amount, 'white')
    pixos.play_sound('boss_hurt.mp3')
end

function FightMode.checkCollisions()
    -- Additional collision checks can go here
end

-- =============================================================================
-- Battle End Conditions
-- =============================================================================

function FightMode.checkBattleEnd()
    local player = FightMode.state.player
    local boss = FightMode.state.boss
    
    if player.hp <= 0 then
        FightMode.defeat()
        return true
    end
    
    if boss.hp <= 0 then
        FightMode.victory()
        return true
    end
    
    return false
end

function FightMode.victory()
    FightMode.state.isActive = false
    
    pixos.show_notification('VICTORY!')
    pixos.play_sound('victory.mp3')
    
    -- Boss defeat animation
    FightMode.bossSprite:playAnimation('defeat')
    pixos.emit_particles(FightMode.bossSprite.pos, { preset = 'flame', count = 100, life = 3000 })
    pixos.screen_shake(15, 1000)
    
    -- Fade out boss
    FightMode.bossSprite:fadeOut(2000)
    
    -- Show results after delay
    pixos.delay(3000, function()
        FightMode.showResults()
        pixos.run_trigger('event/boss_victory')
    end)
end

function FightMode.defeat()
    FightMode.state.isActive = false
    
    pixos.show_notification('DEFEAT...')
    pixos.play_sound('defeat.mp3')
    
    FightMode.playerSprite:playAnimation('defeat')
    
    pixos.delay(2000, function()
        pixos.run_trigger('event/boss_defeat')
    end)
end

function FightMode.showResults()
    local results = {
        time = math.floor(FightMode.state.battleTime / 1000),
        damageDealt = FightMode.state.damageDealt,
        damageTaken = FightMode.state.damageTaken,
        dodges = FightMode.state.dodgesSuccessful,
        skills = FightMode.state.skillsUsed,
    }
    
    pixos.show_battle_results(results)
end

-- =============================================================================
-- UI Updates
-- =============================================================================

function FightMode.updateHUD()
    local player = FightMode.state.player
    local boss = FightMode.state.boss
    
    pixos.update_health_bar('player', player.hp, player.maxHp)
    pixos.update_health_bar('boss', boss.hp, boss.maxHp)
    pixos.update_stamina_bar(player.stamina, player.maxStamina)
    pixos.update_mp_bar(player.mp, player.maxMp)
    
    if player.comboCount > 1 then
        pixos.show_combo(player.comboCount)
    end
end

function FightMode.regenStamina(dt)
    local player = FightMode.state.player
    if not player.isBlocking and not player.isDodging then
        player.stamina = math.min(player.maxStamina, player.stamina + FightMode.config.staminaRegen)
    end
end

-- =============================================================================
-- Utility
-- =============================================================================

function FightMode.distance(pos1, pos2)
    local dx = pos2.x - pos1.x
    local dy = pos2.y - pos1.y
    return math.sqrt(dx * dx + dy * dy)
end

function FightMode.togglePause()
    FightMode.state.isPaused = not FightMode.state.isPaused
    if FightMode.state.isPaused then
        pixos.open_menu('pause')
    else
        pixos.close_menu()
    end
end

function FightMode.playIntro()
    -- Play cutscene or boss intro
    pixos.play_cutscene('final-boss', function()
        FightMode.state.isActive = true
    end)
end

-- =============================================================================
-- Set as active mode
-- =============================================================================
pixos.set_mode('fight')