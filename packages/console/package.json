{
  "name": "pixospritz-console",
  "version": "1.0.0",
  "description": "PixoSpritz Console - Web player for running PixoSpritz games",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--openssl-legacy-provider --max_old_space_size=8192\" react-app-rewired start",
    "start": "NODE_OPTIONS=\"--openssl-legacy-provider --max_old_space_size=8192\" react-app-rewired start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-app-rewired build",
    "lint": "eslint src --ext .js,.jsx --max-warnings=9999",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "build",
    "README.md"
  ],
  "keywords": [
    "pixospritz",
    "console",
    "game-player",
    "webgl"
  ],
  "homepage": "https://pixospritz.com",
  "repository": {
    "url": "https://github.com/ConflictingTheories/calliope-pixos.git",
    "type": "git"
  },
  "author": "Kyle Derby MacInnis",
  "license": "CC-BY-NC-SA-4.0",
  "dependencies": {
    "pixospritz-core": "*",
    "pixoscript": "*",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-scripts": "4.0.3",
    "typescript": "^4.8.4",
    "web-vitals": "^1.0.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@types/minimatch": "^5.1.2",
    "customize-cra": "1.0.0",
    "react-app-rewired": "2.1.8"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
