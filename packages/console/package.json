{
  "name": "pixospritz-console",
  "version": "1.0.1",
  "description": "PixoSpritz Console - Web player for running PixoSpritz games",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "build",
    "README.md"
  ],
  "keywords": [
    "pixospritz",
    "console",
    "game-player",
    "webgl"
  ],
  "homepage": "https://pixospritz.com",
  "repository": {
    "url": "https://github.com/ConflictingTheories/calliope-pixos.git",
    "type": "git"
  },
  "author": "Kyle Derby MacInnis",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "pixospritz-core": "*",
    "pixoscript": "*",
    "pixospritz-specs": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "typescript": "^4.8.4",
    "web-vitals": "^1.0.1",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.3.5"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
