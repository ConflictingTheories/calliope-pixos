<svg width="640" height="360" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="640" height="360" fill="#1a1a2e"/>
  
  <!-- Grid Pattern -->
  <defs>
    <pattern id="grid2" width="40" height="40" patternUnits="userSpaceOnUse">
      <rect width="40" height="40" fill="none" stroke="#252540" stroke-width="1"/>
    </pattern>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b9d;stop-opacity:0.8" />
      <stop offset="50%" style="stop-color:#4ecdc4;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#ffd93d;stop-opacity:0.8" />
    </linearGradient>
  </defs>
  <rect width="640" height="360" fill="url(#grid2)" opacity="0.2"/>
  
  <!-- Mock Game Scene -->
  <!-- Sky -->
  <rect x="0" y="0" width="640" height="200" fill="#252540"/>
  
  <!-- Ground -->
  <rect x="0" y="200" width="640" height="160" fill="#1a1a2e"/>
  
  <!-- Pixel Trees -->
  <rect x="80" y="160" width="20" height="40" fill="#3bb5ad"/>
  <rect x="70" y="140" width="40" height="20" fill="#3bb5ad"/>
  <rect x="60" y="120" width="60" height="20" fill="#3bb5ad"/>
  
  <rect x="500" y="160" width="20" height="40" fill="#3bb5ad"/>
  <rect x="490" y="140" width="40" height="20" fill="#3bb5ad"/>
  <rect x="480" y="120" width="60" height="20" fill="#3bb5ad"/>
  
  <!-- Player Character (pixel art) -->
  <rect x="290" y="240" width="60" height="80" fill="#ff6b9d"/>
  <rect x="300" y="220" width="40" height="20" fill="#ffd93d"/>
  <rect x="310" y="210" width="20" height="10" fill="#e4e4e7"/>
  
  <!-- Buildings in background -->
  <rect x="150" y="150" width="60" height="50" fill="#3f3f46"/>
  <rect x="160" y="160" width="10" height="10" fill="#ffd93d"/>
  <rect x="180" y="160" width="10" height="10" fill="#ffd93d"/>
  <rect x="160" y="180" width="10" height="10" fill="#ffd93d"/>
  <rect x="180" y="180" width="10" height="10" fill="#ffd93d"/>
  
  <rect x="400" y="140" width="80" height="60" fill="#3f3f46"/>
  <rect x="410" y="150" width="12" height="12" fill="#4ecdc4"/>
  <rect x="430" y="150" width="12" height="12" fill="#4ecdc4"/>
  <rect x="450" y="150" width="12" height="12" fill="#4ecdc4"/>
  <rect x="410" y="170" width="12" height="12" fill="#4ecdc4"/>
  <rect x="430" y="170" width="12" height="12" fill="#4ecdc4"/>
  <rect x="450" y="170" width="12" height="12" fill="#4ecdc4"/>
  
  <!-- Stars -->
  <circle cx="100" cy="50" r="2" fill="#e4e4e7"/>
  <circle cx="200" cy="80" r="2" fill="#e4e4e7"/>
  <circle cx="350" cy="40" r="2" fill="#e4e4e7"/>
  <circle cx="500" cy="70" r="2" fill="#e4e4e7"/>
  <circle cx="550" cy="30" r="2" fill="#e4e4e7"/>
  
  <!-- Title Overlay -->
  <rect x="0" y="0" width="640" height="360" fill="rgba(15, 15, 30, 0.3)"/>
  
  <!-- Center Title -->
  <text x="320" y="180" font-family="Arial, sans-serif" font-size="48" fill="url(#grad2)" text-anchor="middle" font-weight="bold">PixoSpritz</text>
  <text x="320" y="210" font-family="Arial, sans-serif" font-size="20" fill="#e4e4e7" text-anchor="middle">Example Game</text>
  
  <!-- Corner Frame -->
  <rect x="20" y="20" width="60" height="4" fill="url(#grad2)"/>
  <rect x="20" y="20" width="4" height="60" fill="url(#grad2)"/>
  
  <rect x="560" y="20" width="60" height="4" fill="url(#grad2)"/>
  <rect x="616" y="20" width="4" height="60" fill="url(#grad2)"/>
  
  <rect x="20" y="336" width="60" height="4" fill="url(#grad2)"/>
  <rect x="20" y="280" width="4" height="60" fill="url(#grad2)"/>
  
  <rect x="560" y="336" width="60" height="4" fill="url(#grad2)"/>
  <rect x="616" y="280" width="4" height="60" fill="url(#grad2)"/>
</svg>
