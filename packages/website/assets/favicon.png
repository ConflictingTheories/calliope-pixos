<svg width="64" height="64" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="64" height="64" rx="12" fill="#0f0f1e"/>
  
  <!-- Gradient Border -->
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b9d;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#4ecdc4;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ffd93d;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Border -->
  <rect width="62" height="62" x="1" y="1" rx="11" fill="none" stroke="url(#grad)" stroke-width="2"/>
  
  <!-- Pixel Art Style Logo -->
  <!-- P -->
  <rect x="12" y="16" width="4" height="16" fill="#ff6b9d"/>
  <rect x="16" y="16" width="8" height="4" fill="#ff6b9d"/>
  <rect x="24" y="20" width="4" height="4" fill="#ff6b9d"/>
  <rect x="16" y="24" width="8" height="4" fill="#ff6b9d"/>
  
  <!-- S -->
  <rect x="32" y="16" width="12" height="4" fill="#4ecdc4"/>
  <rect x="32" y="20" width="4" height="4" fill="#4ecdc4"/>
  <rect x="32" y="24" width="12" height="4" fill="#4ecdc4"/>
  <rect x="40" y="28" width="4" height="4" fill="#4ecdc4"/>
  <rect x="32" y="32" width="12" height="4" fill="#4ecdc4"/>
  
  <!-- Decorative pixels -->
  <rect x="12" y="40" width="4" height="4" fill="#ffd93d"/>
  <rect x="20" y="40" width="4" height="4" fill="#ffd93d"/>
  <rect x="28" y="40" width="4" height="4" fill="#a78bfa"/>
  <rect x="36" y="40" width="4" height="4" fill="#a78bfa"/>
  <rect x="44" y="40" width="4" height="4" fill="#ffd93d"/>
</svg>
