{
  "name": "pixospritz-monorepo",
  "version": "1.0.0",
  "description": "PixoSpritz - A WebGL-based game engine and editor ecosystem",
  "workspaces": [
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "clean": "rimraf packages/*/dist packages/*/build",
    "build": "node scripts/build.mjs",
    "build:script": "npm run build -w pixoscript",
    "build:core": "npm run build:core-c && npm run build:core-js",
    "build:core-js": "npm run build -w pixospritz-core",
    "build:editor": "npm run build -w pixospritz-editor",
    "build:console": "npm run build -w pixospritz-console",
    "build:website": "npm run build -w pixospritz-website",
    "build:arm": "echo \"Please see /packages/arm-linux/build.sh and Readme\"",
    "build:core-c": "echo \"Please see /packages/core-c/build.sh and Readme\"",
    "dev": "npm run dev:editor",
    "dev:editor": "npm run dev -w pixospritz-editor",
    "dev:console": "npm run dev -w pixospritz-console",
    "start:server": "npm run start -w pixospritz-server",
    "lint": "node scripts/lint-budget.mjs",
    "lint:snapshot": "node scripts/lint-budget.mjs --snapshot",
    "lint:fix": "eslint . --fix && prettier --write '**/*.{js,jsx,ts,tsx,json,md}'",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,md}'",
    "format:check": "prettier --check '**/*.{js,jsx,ts,tsx,json,md}'",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "sbom": "node scripts/sbom.mjs",
    "contracts": "node scripts/check-contracts.mjs"
  },
  "keywords": [
    "pixospritz",
    "pixos",
    "html5",
    "game",
    "react",
    "webgl",
    "canvas",
    "game-engine",
    "editor"
  ],
  "homepage": "https://pixospritz.com",
  "repository": {
    "url": "https://github.com/ConflictingTheories/calliope-pixos.git",
    "type": "git"
  },
  "author": "Kyle Derby MacInnis",
  "license": "CC-BY-NC-SA-4.0",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "eslint": "^9.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
